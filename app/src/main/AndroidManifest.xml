<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ورودی صوتی -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- جست‌وجوی مخاطبین -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- برقراری مستقیم تماس (نیازی به Default Dialer شدن نیست) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- خواندن پیامک‌ها (اپ به‌صورت مستقیم/غیر از Play Store نصب می‌شود) -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- نوتیفیکیشن روی اندروید ۱۳+ (در صورت نیاز آینده) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        بسیار مهم (اندروید ۱۱ به بالا / targetSdk >= 30):
        به‌دلیل «Package Visibility»، اپ به‌صورت پیش‌فرض حتی نمی‌تواند ببیند که
        روی گوشی سرویس تشخیص گفتار یا موتور تبدیل متن به گفتار نصب است یا نه.
        بدون این بخش، SpeechRecognizer.isRecognitionAvailable() همیشه false
        برمی‌گرداند و TTS هم موتوری پیدا نمی‌کند — یعنی دکمه میکروفون ظاهراً
        هیچ کاری نمی‌کند.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!--
        این نسخه اول عمداً بدون آیکون سفارشی است (تا فایل‌های کمتری برای
        ساخت دستی لازم باشد) — اندروید از یک آیکون پیش‌فرض سیستمی استفاده
        می‌کند. آیکون سفارشی در فاز بعد اضافه می‌شود.
    -->
    <application
        android:name=".DastyarApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dastyar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Dastyar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
